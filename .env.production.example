APP_NAME=Absensi
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://absensi.geezplay.site

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=absensi_prod
DB_USERNAME=absensi
DB_PASSWORD=isi-password-kuat-disini

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.geezplay.site
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@geezplay.site"
MAIL_FROM_NAME="${APP_NAME}"

# Akun super admin awal (dipakai sekali saat migrate --seed).
SEED_ADMIN_EMAIL=admin@absensi.geezplay.site
SEED_ADMIN_PASSWORD=isi-password-admin-awal-disini
